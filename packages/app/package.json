{
  "name": "@preparados/app",
  "version": "0.1.0",
  "description": "PWA de Preparados.app: celular primero, funciona sin conexión, datos en el dispositivo.",
  "type": "module",
  "private": true,
  "scripts": {
    "catalogo": "node scripts/preparar-catalogo.mjs",
    "iconos": "node scripts/iconos.mjs",
    "dev": "npm run catalogo && vite",
    "build": "npm run catalogo && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@preparados/datos": "*",
    "@preparados/dominio": "*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
